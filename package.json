{
  "name": "nginxwebnodeplugin",
  "version": "1.0.374",
  "description": "A nginx proxy server configuration template for webNode.",
  "keywords": [
    "web",
    "backend",
    "proxy",
    "server",
    "configuration",
    "template"
  ],
  "homepage": "https://tsickert.com/nginx-web-node-plugin",
  "bugs": {
    "email": "info@tsickert.com",
    "url": "https://github.com/thaibault/nginx-web-node-plugin/issues"
  },
  "license": "CC-BY-4.0",
  "author": {
    "email": "info@tsickert.com",
    "name": "Torben Sickert",
    "url": "https://tsickert.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/nginx-web-node-plugin.git"
  },
  "main": "index.js",
  "type": "module",
  "files": [
    "index.d.ts",
    "index.js",
    "type.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "weboptimizer build:types && weboptimizer build",
    "check": "yarn check:types && yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear",
    "document": "weboptimizer document",
    "lint": "weboptimizer lint",
    "prepare": "yarn build",
    "serve": "yarn build && yarn start",
    "start": "web-node '{plugin: {hotReloading: true}}'",
    "test": "weboptimizer test",
    "test:coverage": "yarn clear && weboptimizer test:coverage",
    "test:coverage:report": "yarn clear && weboptimizer test:coverage:report",
    "update:documentation": "web-documentation",
    "watch": "weboptimizer build --watch"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.1.2",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.10",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "application-server-web-node-plugin": "^1.0.419",
    "clientnode": "^4.0.1533",
    "core-js": "^3.51.0",
    "eslint": "^10.15.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^65.5.5",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jsdoc": "^4.0.5",
    "node-fetch": "^3.3.2",
    "typescript-eslint": "^8.74.0",
    "web-documentation": "^1.0.77",
    "web-node": "^1.0.644",
    "weboptimizer": "^4.0.125"
  },
  "peerDependencies": {
    "application-server-web-node-plugin": "*",
    "clientnode": "*",
    "core-js": "*",
    "node-fetch": "*",
    "web-node": "*"
  },
  "resolutions": {
    "colors": "1.4.0"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "languages": [
      "enUS",
      "deDE",
      "frFR"
    ],
    "name": "nginx-web-node-plugin"
  },
  "webNode": {
    "applicationServer": {
      "proxy": {
        "logFilePath": {
          "access": "/dev/stdout",
          "error": "/dev/stderr"
        },
        "optional": true,
        "url": "http://127.0.0.1/"
      }
    },
    "nginx": {
      "dependencies": [
        "applicationServer"
      ]
    }
  },
  "webOptimizer": {
    "commandLine": {
      "test": {
        "environments": [
          "node"
        ]
      }
    },
    "module": {
      "enforceDeduplication": true
    },
    "targetTechnology": "node",
    "test": {
      "injection": {
        "external": {
          "implicit": {
            "pattern": {
              "exclude": {
                "#": "NOTE: Theses files are ECMAscript file so have to be processed to work with test-runner.",
                "__append__": [
                  {
                    "__evaluate__": "/^(.+\\/)?data-uri-to-buffer(\\/.+)?$/"
                  },
                  {
                    "__evaluate__": "/^(.+\\/)?fetch-blob(\\/.+)?$/"
                  },
                  {
                    "__evaluate__": "/^(.+\\/)?node-fetch(\\/.+)?$/"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
